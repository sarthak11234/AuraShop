// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// Auth.js v5 required models
// ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  addresses Address[]
  refunds  Refund[]
  adminActions AdminAuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  adminRateLimits AdminRateLimit[]
  trackingEvents OrderTrackingEvent[] @relation("OrderTrackingActor")
  returnRequests ReturnRequest[]
  returnStatusEvents ReturnStatusEvent[]
  returnInspections ReturnInspection[]
  exchangeRequests ExchangeRequest[]
  offlineRefunds OfflineRefund[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────
// Product catalogue
// ─────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  subtitle     String
  price        Decimal  @db.Decimal(10, 2)
  category     String
  categoryCode String
  description  String   @db.Text
  details      String[]
  images       Json     // string[] of colour hex or image URLs
  version      String
  isNew        Boolean  @default(false)
  inStock      Boolean  @default(true)
  isPublished  Boolean  @default(true)
  archivedAt   DateTime?
  categoryId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants     ProductVariant[]
  orderItems   OrderItem[]
  categoryRecord Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  returnItems  ReturnItem[]
  exchangeRequests ExchangeRequest[] @relation("replacementProduct")

  @@index([category])
  @@index([slug])
  @@index([categoryId])
  @@index([isPublished, archivedAt])
}

// Per-size variant of a product. Owns stock (and an optional price override),
// so the same product can be offered in multiple sizes with independent
// availability. The legacy `sizes String[]` column was replaced by this —
// sizes are derived from variants in the data-access layer.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String
  sku       String?
  stock     Int      @default(0)
  price     Decimal? @db.Decimal(10, 2) // optional per-size price override
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]
  returnItems ReturnItem[] @relation("variant")
  exchangeRequests ExchangeRequest[] @relation("replacementVariant")

  @@unique([productId, size])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model InventoryAdjustment {
  id               String   @id @default(cuid())
  variantId        String
  actorId          String
  previousQuantity Int
  newQuantity      Int
  difference       Int
  reason           String
  createdAt        DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor   User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([actorId, createdAt])
}

model AdminRateLimit {
  actorId    String
  action     String
  windowStart DateTime
  count      Int      @default(0)

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([actorId, action, windowStart])
  @@index([windowStart])
}

// ─────────────────────────────────────────────────
// Orders & Checkout
// ─────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  guestEmail      String?
  guestName       String?
  guestPhone      String?
  idempotencyKey  String?     @unique
  guestAccessTokenHash String?
  status          OrderStatus @default(PENDING)
  paymentStatus   String      @default("pending")
  subtotal        Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("USD")
  shippingAddress Json?
  billingAddress  Json?
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  inventoryReservedAt DateTime?
  inventoryRestoredAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payment   Payment?
  refunds   Refund[]
  addresses Address[]
  trackingEvents OrderTrackingEvent[]
  returnRequests ReturnRequest[]
  exchangeRequests ExchangeRequest[]
  offlineRefunds OfflineRefund[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      String
  productId    String
  productTitle String
  productSlug  String
  productImage String?
  variantId    String?
  size         String?
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  lineTotal    Decimal  @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id                Int       @id @default(autoincrement())
  orderId           String    @unique
  provider          String
  providerPaymentId String?   @unique
  providerOrderId   String?
  providerSignature String?
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("USD")
  status            String    @default("pending")
  method            String?
  gatewayResponse   Json?
  failureReason     String?
  verifiedAt        DateTime?
  capturedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([providerPaymentId])
  @@index([providerOrderId])
  @@index([status])
}

model Refund {
  id               Int      @id @default(autoincrement())
  paymentId        Int
  orderId          String
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  reason           String?
  status           String   @default("pending")
  providerRefundId String?  @unique
  failureReason    String?
  gatewayResponse  Json?
  actorId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([providerRefundId])
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       String?
  orderId      String?
  kind         String   @default("shipping")
  firstName    String
  lastName     String
  company      String?
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("USA")
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([userId, orderId])
}

// ─────────────────────────────────────────────────
// Order tracking
// ─────────────────────────────────────────────────

// Immutable customer-facing fulfilment timeline. Events are created only by
// real order status transitions or an authorized admin tracking update; the
// unique (orderId, status) key makes repeated processing idempotent.
model OrderTrackingEvent {
  id             Int               @id @default(autoincrement())
  orderId        String
  status         OrderStatus
  title          String
  description    String?
  location       String?
  source         TrackingEventSource @default(SYSTEM)
  carrier        String?
  trackingNumber String?
  createdBy      String?
  createdAt      DateTime          @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor   User? @relation("OrderTrackingActor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([orderId, status])
  @@index([orderId, createdAt])
  @@index([createdBy])
}

// ─────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────

enum TrackingEventSource {
  SYSTEM
  ADMIN
  CUSTOMER
  CARRIER
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  PACKED
  FAILED_DELIVERY
}

// ─────────────────────────────────────────────────
// Returns, Exchanges & Refunds (Phase 12.2)
// ─────────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  RETURN_SHIPPED
  RETURN_RECEIVED
  INSPECTION_PENDING
  INSPECTED
  REFUND_PENDING
  REFUND_PROCESSING
  REFUNDED
  EXCHANGE_PENDING
  EXCHANGE_PROCESSING
  EXCHANGED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  WRONG_SIZE
  WRONG_PRODUCT
  DAMAGED
  DEFECTIVE
  DIFFERS_FROM_DESCRIPTION
  QUALITY_ISSUE
  OTHER
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum ItemCondition {
  UNOPENED
  LIKE_NEW
  GOOD
  DAMAGED
  DEFECTIVE
  INCOMPLETE
  OTHER
}

enum RefundMethod {
  RAZORPAY
  BANK_TRANSFER
  UPI
  OTHER
}

enum OfflineRefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnEventSource {
  SYSTEM
  ADMIN
  CUSTOMER
  CARRIER
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
  STOCK_RESERVED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model ReturnRequest {
  id              String          @id @default(cuid())
  returnNumber    String          @unique
  userId          String
  orderId         String
  status          ReturnStatus    @default(REQUESTED)
  returnReason    ReturnReason
  returnType      ReturnType      @default(REFUND)
  customerComments String?
  adminNotes      String?
  customerNotes   String?
  requestedAt     DateTime        @default(now())
  resolvedAt      DateTime?
  refundAmount    Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   ReturnItem[]
  events  ReturnStatusEvent[]
  shipment ReturnShipment?
  inspections ReturnInspection[]
  exchangeRequest ExchangeRequest?
  offlineRefund OfflineRefund?

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([returnNumber])
  @@index([createdAt])
}

model ReturnItem {
  id               String   @id @default(cuid())
  returnRequestId  String
  orderItemId      Int
  productId        String
  productTitle     String
  productSlug      String
  productImage     String?
  variantId        String?
  size               String?
  requestedQuantity Int
  approvedQuantity   Int   @default(0)
  receivedQuantity   Int   @default(0)
  acceptedQuantity   Int   @default(0)
  rejectedQuantity   Int   @default(0)
  condition          ItemCondition?
  restockable        Boolean @default(false)
  price              Decimal   @db.Decimal(10, 2) // historical purchase price
  lineTotal          Decimal   @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation("variant", fields: [variantId], references: [id], onDelete: SetNull)
  inspections   ReturnInspection[]

  @@index([returnRequestId])
  @@index([orderItemId])
  @@index([variantId])
}

model ReturnStatusEvent {
  id           Int      @id @default(autoincrement())
  returnRequestId String
  status       ReturnStatus
  title        String
  description  String?
  source       ReturnEventSource @default(SYSTEM)
  actorId      String?
  createdAt    DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([returnRequestId, createdAt])
  @@index([returnRequestId, status])
}

model ReturnShipment {
  id           String   @id @default(cuid())
  returnRequestId String @unique
  carrier      String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

model ReturnInspection {
  id               String   @id @default(cuid())
  returnRequestId  String
  returnItemId     String
  receivedQuantity  Int
  inspectedQuantity Int
  acceptedQuantity  Int
  rejectedQuantity  Int
  condition          ItemCondition
  restockable        Boolean @default(false)
  inspectionNotes    String?
  inspectedAt        DateTime
  inspectorId        String
  createdAt          DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnItem    ReturnItem    @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  inspector     User          @relation(fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([returnRequestId])
  @@index([returnItemId])
  @@index([inspectorId, createdAt])
}

model ExchangeRequest {
  id                String        @id @default(cuid())
  returnRequestId   String        @unique
  userId            String
  orderId           String
  status            ExchangeStatus @default(PENDING)
  replacementProductId String
  replacementVariantId String?
  replacementQuantity Int
  priceDifference     Decimal?    @db.Decimal(10, 2)
  reservedAt          DateTime?
  reservedStockRestoredAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  returnRequest      ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  replacementProduct Product        @relation("replacementProduct", fields: [replacementProductId], references: [id], onDelete: Restrict)
  replacementVariant ProductVariant? @relation("replacementVariant", fields: [replacementVariantId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model OfflineRefund {
  id              String   @id @default(cuid())
  orderId         String
  returnRequestId String @unique
  amount          Decimal   @db.Decimal(10, 2)
  currency        String   @default("USD")
  method          RefundMethod
  transactionReference String
  status          OfflineRefundStatus @default(PENDING)
  actorId         String?
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnReq  ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([returnRequestId])
  @@index([status])
}
